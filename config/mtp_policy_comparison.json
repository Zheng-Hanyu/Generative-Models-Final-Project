        "num_speculative_tokens": 3
      }
    },
    {
      "name": "mtp-k5",
      "speculative_config": {
        "method": "mtp",
        "num_speculative_tokens": 5
      }
    },
    {
      "name": "mtp-k6",
      "speculative_config": {
        "method": "mtp",
        "num_speculative_tokens": 6
      }
    },
    {
      "name": "mtp-k7",
      "speculative_config": {
        "method": "mtp",
        "num_speculative_tokens": 7
      }
    },
    {
      "name": "mtp-dynamic-oracle",
      "speculative_config": {
        "method": "mtp",
        "num_speculative_tokens": 7,
        "num_speculative_tokens_per_batch_size": [
          [1, 1, 7],
          [2, 4, 6],
          [5, 16, 7],
          [17, 256, 5]
        ]
      }
    },
    {
      "name": "mtp-dynamic-smooth",
      "speculative_config": {
        "method": "mtp",
        "num_speculative_tokens": 6,
